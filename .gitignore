# Игнорировать отчеты (docx, pdf) в папках лабораторных работ, кроме папки отчеты
лаб*/**/*.docx
лаб*/**/*.pdf
лаб*/**/*.odt

# КРИТИЧЕСКОЕ: Приватные ключи и keyring-файлы
лаб*/**/*.sec.asc
лаб*/**/private-keys-v1.d/
лаб*/**/private-keys-v1.d/*.key
лаб*/**/pubring.kbx
лаб*/**/pubring.kbx~
лаб*/**/trustdb.gpg
лаб*/**/tofu.db
лаб*/**/sshcontrol
лаб*/**/*.gpg

# Файлы с персональными данными
лаб*/keys*.txt
